{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "participants.schema.json",
  "title": "Participant registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["organizer", "organizations"],
  "properties": {
    "organizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github"],
      "properties": {
        "github": { "$ref": "#/$defs/handle" }
      }
    },
    "organizations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/organization" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+$",
      "maxLength": 24,
      "description": "Lowercase letters and digits only; used as a segment of run IDs"
    },
    "handle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$",
      "description": "GitHub login, without the leading @"
    },
    "role": {
      "type": "string",
      "enum": ["mcp-client", "mcp-server", "op", "resource-as", "gateway"]
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "roles"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/role" }
        }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "kind", "implementations"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["organization", "tool"] },
        "implementations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/implementation" }
        },
        "attesters": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/handle" }
        },
        "contacts": {
          "type": "array",
          "items": { "type": "string", "format": "email" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "organization" } } },
          "then": {
            "required": ["attesters"],
            "properties": { "attesters": { "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "tool" } } },
          "then": {
            "properties": { "attesters": { "maxItems": 0 } }
          }
        }
      ]
    }
  }
}
